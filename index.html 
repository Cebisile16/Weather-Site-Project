<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cape Town Weather</title>

    <!-- Link CSS -->
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <div class="card">

        <div class="current">
            <span class="emoji">🌤</span>
            <h1 id="city-heading">Currently 21° in Cape Town</h1>
        </div>

        <p class="range-now">
            13° / <span class="high-temp">23°</span>
        </p>

        <hr class="divider">

        <ul class="forecast">

            <li>
                <div class="day-info">
                    <span class="day-emoji">🌧</span>
                    <span class="day-name">Tomorrow</span>
                </div>

                <span class="day-range">
                    10° / <span class="high-temp">22°</span>
                </span>
            </li>

            <li>
                <div class="day-info">
                    <span class="day-emoji">🌥</span>
                    <span class="day-name">Saturday</span>
                </div>

                <span class="day-range">
                    15° / <span class="high-temp">17°</span>
                </span>
            </li>

            <li>
                <div class="day-info">
                    <span class="day-emoji">☀️</span>
                    <span class="day-name">Sunday</span>
                </div>

                <span class="day-range">
                    25° / <span class="high-temp">28°</span>
                </span>
            </li>

        </ul>

        <button class="change-city">
            Change City
        </button>

        <p class="credit">
            Coded by Cebisile Ngubane
        </p>

    </div>

    <!-- linking it to JS -->
    <script src="js/app.js"></script>

</body>
</html>